{
  "name": "skhooler-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Skhooler backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "npm install && npx prisma generate && npx prisma migrate deploy",
    "postinstall": "npx prisma generate",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "@supabase/supabase-js": "^2.49.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "opossum": "^8.4.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "resend": "^4.1.0",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.0",
    "prisma": "^6.8.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
