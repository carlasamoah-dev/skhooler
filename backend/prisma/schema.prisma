datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupPricingModel {
  FREE
  PAID
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum GroupRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum JoinApproval {
  AUTOMATIC
  MANUAL
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum CourseAccessType {
  OPEN
  TIER_LOCKED
  PRIVATE_GRANT
}

enum EventLocationType {
  ONLINE_LINK
  PHYSICAL_ADDRESS
  RECORDED_SESSION
}

enum EventAccessType {
  ALL_MEMBERS
  TIER_LOCKED
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum NotificationType {
  NEW_POST
  POST_LIKE
  NEW_COMMENT
  COMMENT_REPLY
  COMMENT_LIKE
  POLL_VOTE
  EVENT_REMINDER
  EVENT_STARTING_SOON
  EVENT_CANCELLED
  JOIN_REQUEST
  JOIN_APPROVED
  JOIN_DECLINED
  ROLE_CHANGED
  TIER_CHANGED
  COURSE_ACCESS_GRANTED
}

enum SubscriptionType {
  PLATFORM_OWNER
  GROUP_MEMBERSHIP
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  FAILED
  REFUNDED
}

enum ReferralStatus {
  PENDING
  AVAILABLE
  PAID
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url") @db.Text
  bio             String?   @db.VarChar(500)
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz()
  isOnline        Boolean   @default(false) @map("is_online")
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()
  referralCode    String?   @unique @map("referral_code") @db.VarChar(20)

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  // Phase 2 additions
  ownedGroups      Group[]       @relation("OwnedGroups")
  groupMemberships GroupMember[]
  joinRequests     JoinRequest[] @relation("JoinRequests")
  reviewedRequests JoinRequest[] @relation("ReviewedRequests")

  // Phase 3 additions
  createdInvites    GroupInvite[]   @relation("CreatedInvites")
  moderationActions ModerationLog[] @relation("ModerationActions")

  // Phase 4 additions
  posts        Post[]        @relation("AuthorPosts")
  comments     Comment[]     @relation("AuthorComments")
  postLikes    PostLike[]    @relation("UserPostLikes")
  commentLikes CommentLike[] @relation("UserCommentLikes")
  pollVotes    PollVote[]    @relation("UserPollVotes")

  // Phase 5 additions
  lessonProgress      LessonProgress[]
  courseAccess        CourseMemberAccess[] @relation("UserCourseAccess")
  grantedCourseAccess CourseMemberAccess[] @relation("GrantedCourseAccess")

  // Phase 6 additions
  createdEvents Event[]     @relation("CreatedEvents")
  eventRsvps    EventRsvp[] @relation("UserEventRsvps")

  // Phase 7 additions
  notifications          Notification[]          @relation("UserNotifications")
  triggeredNotifications Notification[]          @relation("TriggeredNotifications")
  notificationPreference NotificationPreference?

  // Phase 8 additions
  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]
  referralsMade       Referral[]           @relation("ReferralsMade")
  referredBy          Referral?            @relation("ReferredBy")
  referralEarnings    ReferralEarning[]

  // Phase 10 additions
  isSuperAdmin Boolean @default(false) @map("is_super_admin")

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model Group {
  id                 String            @id @default(uuid()) @db.Uuid
  name               String            @db.VarChar(100)
  slug               String            @unique @db.VarChar(120)
  description        String?           @db.Text
  iconUrl            String?           @map("icon_url") @db.Text
  coverUrl           String?           @map("cover_url") @db.Text
  galleryImages      String[]          @default([]) @map("gallery_images")
  visibility         GroupVisibility   @default(PUBLIC)
  pricingModel       GroupPricingModel @default(FREE) @map("pricing_model")
  price              Decimal?          @db.Decimal(10, 2)
  billingInterval    BillingInterval?  @map("billing_interval")
  trialDays          Int               @default(0) @map("trial_days")
  rules              String?           @db.Text
  aboutContent       String?           @map("about_content") @db.Text
  customUrl          String?           @unique @map("custom_url") @db.VarChar(100)
  joinApproval       JoinApproval      @default(AUTOMATIC) @map("join_approval")
  autoWelcomeMessage String?           @map("auto_welcome_message") @db.Text
  ownerId            String            @map("owner_id") @db.Uuid
  memberCount        Int               @default(0) @map("member_count")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz()

  owner               User                 @relation("OwnedGroups", fields: [ownerId], references: [id])
  members             GroupMember[]
  categories          Category[]
  memberTiers         MemberTier[]
  membershipQuestions MembershipQuestion[]
  externalLinks       GroupExternalLink[]
  joinRequests        JoinRequest[]

  // Phase 3 additions
  invites        GroupInvite[]
  moderationLogs ModerationLog[]

  // Phase 4 additions
  posts Post[]

  // Phase 5 additions
  courses Course[]

  // Phase 6 additions
  events Event[]

  // Phase 7 additions
  notifications Notification[]

  // Phase 8 additions
  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]

  // Phase 9 additions
  webhooks WebhookSubscription[]
  apiKeys  GroupApiKey[]

  // Phase 10 additions
  dailyMetrics DailyGroupMetrics[]

  @@index([ownerId])
  @@index([visibility])
  @@index([createdAt])
  @@index([slug])
  @@map("groups")
}

model GroupMember {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      GroupRole @default(MEMBER)
  tierId    String?   @map("tier_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  group Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier  MemberTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([role])
  @@map("group_members")
}

model MemberTier {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String   @db.VarChar(50)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  group   Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members GroupMember[]

  // Phase 5 additions
  courses Course[]

  // Phase 6 additions
  events Event[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("member_tiers")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String   @db.VarChar(50)
  slug      String   @db.VarChar(60)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Phase 4 additions
  posts Post[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@map("categories")
}

model MembershipQuestion {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  question   String   @db.Text
  position   Int
  isRequired Boolean  @default(true) @map("is_required")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  group   Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  answers JoinRequestAnswer[]

  @@unique([groupId, position])
  @@index([groupId])
  @@map("membership_questions")
}

model GroupExternalLink {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  label     String   @db.VarChar(100)
  url       String   @db.Text
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("group_external_links")
}

model JoinRequest {
  id         String            @id @default(uuid()) @db.Uuid
  groupId    String            @map("group_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  status     JoinRequestStatus @default(PENDING)
  reviewedBy String?           @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?         @map("reviewed_at") @db.Timestamptz()
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  group    Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User                @relation("JoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?               @relation("ReviewedRequests", fields: [reviewedBy], references: [id])
  answers  JoinRequestAnswer[]

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
  @@map("join_requests")
}

model JoinRequestAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  joinRequestId String   @map("join_request_id") @db.Uuid
  questionId    String   @map("question_id") @db.Uuid
  answer        String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  joinRequest JoinRequest        @relation(fields: [joinRequestId], references: [id], onDelete: Cascade)
  question    MembershipQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([joinRequestId])
  @@index([questionId])
  @@map("join_request_answers")
}

model GroupInvite {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  code      String    @unique @db.VarChar(20)
  createdBy String    @map("created_by") @db.Uuid
  maxUses   Int?      @map("max_uses")
  useCount  Int       @default(0) @map("use_count")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz()
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User  @relation("CreatedInvites", fields: [createdBy], references: [id])

  @@index([groupId])
  @@index([code])
  @@map("group_invites")
}

model ModerationLog {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(50)
  targetType String   @map("target_type") @db.VarChar(30)
  targetId   String   @map("target_id") @db.Uuid
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User  @relation("ModerationActions", fields: [actorId], references: [id])

  @@index([groupId])
  @@index([actorId])
  @@index([createdAt])
  @@map("moderation_logs")
}

// Phase 4 Models

model Post {
  id               String    @id @default(uuid()) @db.Uuid
  groupId          String    @map("group_id") @db.Uuid
  authorId         String    @map("author_id") @db.Uuid
  categoryId       String?   @map("category_id") @db.Uuid
  title            String    @db.VarChar(255)
  content          String    @db.Text
  isPinned         Boolean   @default(false) @map("is_pinned")
  pinnedAt         DateTime? @map("pinned_at") @db.Timestamptz()
  isEmailBroadcast Boolean   @default(false) @map("is_email_broadcast")
  broadcastSentAt  DateTime? @map("broadcast_sent_at") @db.Timestamptz()
  actionButtonText String?   @map("action_button_text") @db.VarChar(100)
  actionButtonUrl  String?   @map("action_button_url") @db.Text
  linkPreview      Json?     @map("link_preview")
  videoAssetId     String?   @map("video_asset_id") @db.VarChar(100)
  videoPlaybackId  String?   @map("video_playback_id") @db.VarChar(100)
  attachments      Json?
  likeCount        Int       @default(0) @map("like_count")
  commentCount     Int       @default(0) @map("comment_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()

  group    Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author   User       @relation("AuthorPosts", fields: [authorId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments Comment[]
  likes    PostLike[]
  poll     Poll?

  @@index([groupId])
  @@index([authorId])
  @@index([categoryId])
  @@index([isPinned])
  @@index([createdAt])
  @@map("posts")
}

model Poll {
  id            String    @id @default(uuid()) @db.Uuid
  postId        String    @unique @map("post_id") @db.Uuid
  question      String    @db.Text
  allowMultiple Boolean   @default(false) @map("allow_multiple")
  totalVotes    Int       @default(0) @map("total_votes")
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([postId])
  @@map("polls")
}

model PollOption {
  id        String   @id @default(uuid()) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  text      String   @db.VarChar(255)
  position  Int      @default(0)
  voteCount Int      @default(0) @map("vote_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(uuid()) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, userId])
  @@index([pollId])
  @@index([userId])
  @@map("poll_votes")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model Comment {
  id              String    @id @default(uuid()) @db.Uuid
  postId          String    @map("post_id") @db.Uuid
  authorId        String    @map("author_id") @db.Uuid
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  content         String    @db.Text
  attachments     Json?
  likeCount       Int       @default(0) @map("like_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User          @relation("AuthorComments", fields: [authorId], references: [id], onDelete: Cascade)
  parentComment Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]     @relation("CommentReplies")
  likes         CommentLike[]

  @@index([postId])
  @@index([authorId])
  @@index([parentCommentId])
  @@index([createdAt])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("UserCommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

// Phase 5 Models

model Course {
  id             String           @id @default(uuid()) @db.Uuid
  groupId        String           @map("group_id") @db.Uuid
  title          String           @db.VarChar(100)
  slug           String           @db.VarChar(120)
  description    String?          @db.Text
  coverUrl       String?          @map("cover_url") @db.Text
  position       Int              @default(0)
  isPublished    Boolean          @default(false) @map("is_published")
  accessType     CourseAccessType @default(OPEN) @map("access_type")
  requiredTierId String?          @map("required_tier_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz()

  group        Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requiredTier MemberTier?          @relation(fields: [requiredTierId], references: [id], onDelete: SetNull)
  modules      CourseModule[]
  memberAccess CourseMemberAccess[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([requiredTierId])
  @@map("courses")
}

model CourseModule {
  id          String    @id @default(uuid()) @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  title       String    @db.VarChar(100)
  description String?   @db.Text
  position    Int       @default(0)
  isPublished Boolean   @default(false) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id                   String    @id @default(uuid()) @db.Uuid
  moduleId             String    @map("module_id") @db.Uuid
  title                String    @db.VarChar(150)
  slug                 String    @db.VarChar(170)
  content              String?   @db.Text
  videoAssetId         String?   @map("video_asset_id") @db.VarChar(100)
  videoPlaybackId      String?   @map("video_playback_id") @db.VarChar(100)
  videoDurationSeconds Int?      @map("video_duration_seconds")
  attachments          Json?
  position             Int       @default(0)
  isPublished          Boolean   @default(false) @map("is_published")
  isFreePreview        Boolean   @default(false) @map("is_free_preview")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz()

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model LessonProgress {
  id                  String    @id @default(uuid()) @db.Uuid
  lessonId            String    @map("lesson_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  isCompleted         Boolean   @default(false) @map("is_completed")
  completedAt         DateTime? @map("completed_at") @db.Timestamptz()
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model CourseMemberAccess {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz()

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User   @relation("UserCourseAccess", fields: [userId], references: [id], onDelete: Cascade)
  granter User?  @relation("GrantedCourseAccess", fields: [grantedBy], references: [id])

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@map("course_member_access")
}

// Phase 6 Models

model Event {
  id              String            @id @default(uuid()) @db.Uuid
  groupId         String            @map("group_id") @db.Uuid
  createdBy       String            @map("created_by") @db.Uuid
  title           String            @db.VarChar(150)
  description     String?           @db.Text
  coverUrl        String?           @map("cover_url") @db.Text
  startDate       DateTime          @map("start_date") @db.Timestamptz()
  endDate         DateTime?         @map("end_date") @db.Timestamptz()
  timezone        String            @default("UTC") @db.VarChar(50)
  isAllDay        Boolean           @default(false) @map("is_all_day")
  locationType    EventLocationType @default(ONLINE_LINK) @map("location_type")
  locationUrl     String?           @map("location_url") @db.Text
  locationAddress String?           @map("location_address") @db.Text
  recordingUrl    String?           @map("recording_url") @db.Text
  accessType      EventAccessType   @default(ALL_MEMBERS) @map("access_type")
  requiredTierId  String?           @map("required_tier_id") @db.Uuid
  isRecurring     Boolean           @default(false) @map("is_recurring")
  recurrenceRule  String?           @map("recurrence_rule") @db.VarChar(100)
  attendeeCount   Int               @default(0) @map("attendee_count")
  isCancelled     Boolean           @default(false) @map("is_cancelled")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz()

  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator      User        @relation("CreatedEvents", fields: [createdBy], references: [id])
  requiredTier MemberTier? @relation(fields: [requiredTierId], references: [id], onDelete: SetNull)
  rsvps        EventRsvp[]

  @@index([groupId])
  @@index([startDate])
  @@index([isCancelled])
  @@map("events")
}

model EventRsvp {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @map("event_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  status    RsvpStatus @default(GOING)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("UserEventRsvps", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_rsvps")
}

// Phase 7 Models

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  groupId   String?          @map("group_id") @db.Uuid
  actorId   String?          @map("actor_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.Text
  link      String?          @db.Text
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz()
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user  User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User?  @relation("TriggeredNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([groupId])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  emailNewPost       Boolean  @default(true) @map("email_new_post")
  emailCommentReply  Boolean  @default(true) @map("email_comment_reply")
  emailEventReminder Boolean  @default(true) @map("email_event_reminder")
  inAppAll           Boolean  @default(true) @map("in_app_all")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Phase 8 Models

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  groupId              String?            @map("group_id") @db.Uuid
  type                 SubscriptionType   @default(GROUP_MEMBERSHIP)
  status               SubscriptionStatus @default(ACTIVE)
  planId               String?            @map("plan_id") @db.VarChar(100)
  amount               Decimal            @db.Decimal(10, 2)
  currency             String             @default("USD") @db.VarChar(10)
  billingInterval      BillingInterval    @default(MONTHLY) @map("billing_interval")
  stripeCustomerId     String?            @map("stripe_customer_id") @db.VarChar(100)
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id") @db.VarChar(100)
  currentPeriodStart   DateTime           @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd     DateTime           @map("current_period_end") @db.Timestamptz()
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at") @db.Timestamptz()
  trialEndsAt          DateTime?          @map("trial_ends_at") @db.Timestamptz()
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  group        Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([userId])
  @@index([groupId])
  @@index([status])
  @@map("subscriptions")
}

model PaymentTransaction {
  id                    String        @id @default(uuid()) @db.Uuid
  subscriptionId        String?       @map("subscription_id") @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  groupId               String?       @map("group_id") @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD") @db.VarChar(10)
  status                PaymentStatus @default(SUCCEEDED)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id") @db.VarChar(100)
  stripeInvoiceId       String?       @map("stripe_invoice_id") @db.VarChar(100)
  isDummy               Boolean       @default(false) @map("is_dummy")
  description           String?       @db.Text
  receiptUrl            String?       @map("receipt_url") @db.Text
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  group           Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  referralEarning ReferralEarning?

  @@index([userId])
  @@index([groupId])
  @@index([subscriptionId])
  @@index([createdAt])
  @@map("payment_transactions")
}

model Referral {
  id                 String    @id @default(uuid()) @db.Uuid
  referrerId         String    @map("referrer_id") @db.Uuid
  referredUserId     String    @unique @map("referred_user_id") @db.Uuid
  cookieAttributedAt DateTime? @map("cookie_attributed_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  referrer     User              @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User              @relation("ReferredBy", fields: [referredUserId], references: [id], onDelete: Cascade)
  earnings     ReferralEarning[]

  @@index([referrerId])
  @@map("referrals")
}

model ReferralEarning {
  id             String         @id @default(uuid()) @db.Uuid
  referralId     String         @map("referral_id") @db.Uuid
  referrerId     String         @map("referrer_id") @db.Uuid
  transactionId  String         @unique @map("transaction_id") @db.Uuid
  amount         Decimal        @db.Decimal(10, 2)
  commissionRate Decimal        @default(0.40) @map("commission_rate") @db.Decimal(4, 2)
  status         ReferralStatus @default(PENDING)
  availableAt    DateTime?      @map("available_at") @db.Timestamptz()
  paidAt         DateTime?      @map("paid_at") @db.Timestamptz()
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  referral    Referral           @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referrer    User               @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([status])
  @@map("referral_earnings")
}

// Phase 9 Models

model WebhookSubscription {
  id           String   @id @default(uuid()) @db.Uuid
  groupId      String   @map("group_id") @db.Uuid
  url          String   @db.Text
  secret       String   @db.VarChar(100)
  events       String[]
  isActive     Boolean  @default(true) @map("is_active")
  failureCount Int      @default(0) @map("failure_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  group      Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([groupId])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  webhookId      String   @map("webhook_id") @db.Uuid
  event          String   @db.VarChar(50)
  payload        Json
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body") @db.Text
  durationMs     Int?     @map("duration_ms")
  isSuccess      Boolean  @default(true) @map("is_success")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  webhook WebhookSubscription @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

model GroupApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  groupId    String    @map("group_id") @db.Uuid
  name       String    @db.VarChar(100)
  keyPrefix  String    @map("key_prefix") @db.VarChar(12)
  keyHash    String    @unique @map("key_hash") @db.VarChar(255)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("group_api_keys")
}

// Phase 10 Models

model DailyGroupMetrics {
  id            String   @id @default(uuid()) @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  date          DateTime @db.Date
  totalMembers  Int      @default(0) @map("total_members")
  newMembers    Int      @default(0) @map("new_members")
  activeMembers Int      @default(0) @map("active_members")
  postsCount    Int      @default(0) @map("posts_count")
  commentsCount Int      @default(0) @map("comments_count")
  likesCount    Int      @default(0) @map("likes_count")
  revenue       Decimal  @default(0) @map("revenue") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, date])
  @@index([groupId])
  @@index([date])
  @@map("daily_group_metrics")
}
