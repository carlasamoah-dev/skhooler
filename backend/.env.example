# Environment setting
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database configuration
# Supabase pooler format (port 6543, pgbouncer=true, connection_limit=5, pool_timeout=10)
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10
# Direct connection (port 5432)
DIRECT_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Redis configuration
REDIS_URL=redis://localhost:6379

# JWT secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Resend for Emails
RESEND_API_KEY=re_123456789
EMAIL_FROM=noreply@skhooler.com

# Supabase Storage / Auth
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
